# Dependencies
node_modules/
*/node_modules/

# Database files, journals and backups (never commit real data)
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*backup*.db

# Environment variables (only the example is committed)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
build/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

